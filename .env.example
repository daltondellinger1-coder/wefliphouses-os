# Server config
PORT=3000

# Data mode: "mock" (default) or "live"
# - mock: dashboard runs entirely on bundled sample data (no API calls)
# - live: backend will call real APIs when credentials below are set, and fall
#         back to mock data per-source if a call fails
DATA_MODE=mock

# Auto-refresh interval in milliseconds (frontend polls /api/dashboard)
# Default 300000 = 5 minutes. Allowed range per spec: 5-15 minutes.
REFRESH_INTERVAL_MS=300000

# -----------------------------------------------------------------------------
# QuickBooks Online (OAuth 2.0)
# Docs: https://developer.intuit.com/app/developer/qbo/docs/get-started
# Production environment endpoint:
#   https://quickbooks.api.intuit.com/v3/company/{realmId}/...
# Sandbox endpoint:
#   https://sandbox-quickbooks.api.intuit.com/v3/company/{realmId}/...
# -----------------------------------------------------------------------------
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_ACCESS_TOKEN=
QBO_REFRESH_TOKEN=
QBO_ENVIRONMENT=sandbox

# -----------------------------------------------------------------------------
# FlipperForce
# NOTE: FlipperForce does not publish a public REST API as of this writing.
# Options to wire up V1:
#   1. Use a CSV export dropped into backend/data/flipperforce_export.csv
#   2. Wire to a private/partner API if available (set the env vars below)
#   3. Use Zapier/Make webhooks to push project updates into this app
# -----------------------------------------------------------------------------
FLIPPERFORCE_API_BASE=
FLIPPERFORCE_API_KEY=
FLIPPERFORCE_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# REsimpli
# Docs: https://resimpli.com/ (API access typically requires contacting support)
# -----------------------------------------------------------------------------
RESIMPLI_API_BASE=https://api.resimpli.com
RESIMPLI_API_KEY=
RESIMPLI_ACCOUNT_ID=
