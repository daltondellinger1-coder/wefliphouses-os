# Server config
PORT=3000

# Data mode: "mock" (default) or "live"
# - mock: dashboard runs entirely on bundled sample data (no API calls)
# - live: backend will call real APIs when credentials below are set, and fall
#         back to mock data per-source if a call fails
DATA_MODE=mock

# Auto-refresh interval in milliseconds (frontend polls /api/dashboard)
# Default 300000 = 5 minutes. Allowed range per spec: 5-15 minutes.
REFRESH_INTERVAL_MS=300000

# -----------------------------------------------------------------------------
# QuickBooks Online (OAuth 2.0)
# Docs: https://developer.intuit.com/app/developer/qbo/docs/get-started
#
# One-time setup:
#   1. In the Intuit developer dashboard, set the app's Redirect URI to
#      EXACTLY the value of QBO_REDIRECT_URI below.
#   2. Run the app, then visit http://localhost:3000/api/qbo/connect
#   3. Authorize the WFH company. The callback stores tokens at
#      backend/data/qbo_tokens.json (gitignored). They auto-refresh.
# -----------------------------------------------------------------------------
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_ENVIRONMENT=production
QBO_REDIRECT_URI=http://localhost:3000/api/qbo/callback
# These two are optional; if you already have tokens from elsewhere put them
# here. Otherwise leave blank and use the /api/qbo/connect flow above.
QBO_ACCESS_TOKEN=
QBO_REFRESH_TOKEN=

# -----------------------------------------------------------------------------
# FlipperForce
# NOTE: FlipperForce does not publish a public REST API.
# Three ways to wire it up:
#   1. CSV drop: export Projects to CSV, place at
#      backend/data/flipperforce_export.csv (wins over the API if present)
#   2. Private/partner API: set FLIPPERFORCE_API_BASE + KEY, then visit
#      http://localhost:3000/api/flipperforce/probe to find which
#      FLIPPERFORCE_AUTH_MODE (bearer | xapikey | apitoken | token | cookie)
#      and FLIPPERFORCE_PROJECTS_PATH the server accepts.
#   3. Webhook ingest via Zapier/Make (extend flipperforceService to read from
#      a local store).
# -----------------------------------------------------------------------------
FLIPPERFORCE_API_BASE=https://app.flipperforce.com
FLIPPERFORCE_API_KEY=
FLIPPERFORCE_AUTH_MODE=bearer
FLIPPERFORCE_PROJECTS_PATH=/api/v1/projects
FLIPPERFORCE_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# REsimpli
# API access typically requires contacting REsimpli support.
# -----------------------------------------------------------------------------
RESIMPLI_API_BASE=https://api.resimpli.com
RESIMPLI_API_KEY=
RESIMPLI_ACCOUNT_ID=
